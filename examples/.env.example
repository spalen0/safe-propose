# Copy to .env in the CONSUMING multisig repo and fill in. NEVER commit the filled file.
# This template ships empty — production Safe addresses, RPC URLs, chat IDs, and keys
# belong in the consuming repo's untracked env / GitHub secrets, not in this engine repo.

# --- RPC (per network; every chain connects via the node provider with its own URI) ---
# Prefer a fork-capable node provider over gateway keys — a stalled Tenderly gateway
# was the original hang source (docs/ARCHITECTURE.md → 02a). Never commit a URL with a key.
ETH_RPC=
BASE_RPC=
ARB_RPC=
OP_RPC=
HYPEREVM_RPC=
KATANA_RPC=
RISE_RPC=
ROBINHOOD_RPC=

# --- Safe addresses (per network) ---
# Only ETH_SAFE_ADDRESS is strictly required: any chain without its own
# <PREFIX>_SAFE_ADDRESS falls back to ETH_SAFE_ADDRESS. Set a per-chain value to
# override the fallback for that chain (the CLI warns when the fallback is used).
ETH_SAFE_ADDRESS=
BASE_SAFE_ADDRESS=
ARB_SAFE_ADDRESS=
OP_SAFE_ADDRESS=
HYPEREVM_SAFE_ADDRESS=
KATANA_SAFE_ADDRESS=
RISE_SAFE_ADDRESS=
ROBINHOOD_SAFE_ADDRESS=

# --- Proposer (delegate) ---
# Either reference an Ape keyfile account, or supply the key here (env, untracked).
PROPOSER_PRIVATE_KEY=      # registered delegate / proposer key
PROPOSER_ACCOUNT=

# --- Safe Transaction Service ---
# Required for https://api.safe.global gateway chains
# (ethereum/base/arbitrum/optimism/hyperevm/robinhood). Sent only to api.safe.global.
APE_SAFE_GATEWAY_API_KEY=
SAFE_TRANSACTION_SERVICE_REQUEST_TIMEOUT=10
# Optional. HyperEVM defaults to https://api.safe.global/tx-service/hyper/api.
# Keep the /api suffix if you override — ape-safe appends /v1/... paths to this base.
HYPEREVM_TX_SERVICE_URL=
# Optional. Robinhood defaults to https://api.safe.global/tx-service/robinhood/api.
ROBINHOOD_TX_SERVICE_URL=

# --- Explorer / ABI tokens (ape-etherscan; optional) ---
ETHERSCAN_TOKEN=
BASESCAN_TOKEN=
ARBISCAN_TOKEN=
OPTIMISTIC_ETHERSCAN_TOKEN=

# --- Telegram notification (optional; `send --notify`) ---
# TELEGRAM_TOKEN:   bot token from @BotFather. Create a bot, then add it to your group.
# TELEGRAM_CHAT_ID: the target chat/group id (negative for groups, e.g. -1001234567890).
#   Find it via https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the group,
#   or with @RawDataBot. Both unset → notifications are silently skipped.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
